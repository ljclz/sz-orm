# 真库测试统一凭据模板（复制为 .env.real-db 后填写；.env.* 已被 .gitignore 覆盖）
# 变量含义与消费方见 docs/e2e-env-config.md「变量入口总表」
# 禁止把真实凭据提交到仓库。

# ---- 旧集成套件（sz-orm-sqlx / sz-orm-core 的 --ignored 测试）----
SZ_ORM_PG_URL=postgres://USER:PASSWORD@127.0.0.1:5432/sz_orm_test
SZ_ORM_MYSQL_URL=mysql://USER:PASSWORD@127.0.0.1:3306/sz_orm_test
SZ_ORM_ORACLE_PASSWORD=
SZ_ORM_MSSQL_PASSWORD=

# ---- e2e 套件（packages/sz-orm-core/tests/e2e_*.rs）----
SZ_ORM_E2E_PG_URL=postgres://USER:PASSWORD@HOST:5432/DB
SZ_ORM_E2E_MYSQL_URL_TEST=mysql://USER:PASSWORD@HOST:3306/DB
SZ_ORM_E2E_MYSQL_URL_SHOP=mysql://USER:PASSWORD@HOST:3306/shop
SZ_ORM_E2E_MYSQL_URL_NJSZJT=mysql://USER:PASSWORD@HOST:3306/njszjt
SZ_ORM_E2E_ORACLE_USER=
SZ_ORM_E2E_ORACLE_PASSWORD=
SZ_ORM_E2E_ORACLE_CONNECT_STRING=127.0.0.1:1521/freepdb1

# 跳过即失败（CI 用）：SZ_ORM_E2E_STRICT=1 或 SZ_ORM_E2E_REQUIRED=mysql,postgres
# SZ_ORM_E2E_STRICT=0

# 输出日志路径（默认 docs/assessment/real-db-run-<UTC 时间戳>.log）
# SZ_ORM_REAL_DB_OUT=
